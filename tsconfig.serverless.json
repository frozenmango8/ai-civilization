{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": ".vercel/runtime-check",
    "rootDir": "."
  },
  "include": ["api/**/*.ts", "server/**/*.ts", "src/world/**/*.ts"],
  "exclude": ["node_modules", ".vercel"]
}
