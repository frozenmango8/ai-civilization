# Server-only. Never use VITE_ prefixes for secrets. No real credentials below.
# Neon: copy the pooled connection string, including its TLS options.
DATABASE_URL=
# Generate TWO distinct random secrets, at least 24 characters (32+ recommended).
CRON_SECRET=
ADMIN_SECRET=

# Terra is a faction name. Supply an exact model ID available to your OpenAI account.
# No model alias or replacement is selected automatically.
OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=

# Use the current standard, non-cached USD / million-token price of your EXACT models.
# Positive pricing is required before AI mode is enabled. Zero disables configuration.
# Include any provider price premiums in these rates; overestimating is safer.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
ANTHROPIC_INPUT_USD_PER_MILLION=0
ANTHROPIC_OUTPUT_USD_PER_MILLION=0

# Per UTC day, across ALL visitors, ticks and restarts. Zero stops paid calls.
DAILY_TOKEN_BUDGET=200000
DAILY_USD_BUDGET=5
PROVIDER_DAILY_TOKEN_BUDGET=100000
PROVIDER_DAILY_USD_BUDGET=2
